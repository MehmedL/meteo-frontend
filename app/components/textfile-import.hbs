<form class="upload" {{on "submit" this.submit}}>
  <h3>Импорт на текстов файл</h3>

  <label class="upload__field">
    <span>Изберете .txt файл (до 5MB)</span>
    <input
      type="file"
      accept=".txt,text/plain"
      {{on "change" this.selectFile}}
    />
  </label>

  <button type="submit" class="upload__button" disabled={{this.isDisabled}}>
    {{if this.isUploading "Качване..." "Импортирай"}}
  </button>

  {{! Добавен aria-live за достъпност }}
  {{#if this.inserted}}
    <p class="upload__ok" aria-live="polite">✓ Импортирани редове:
      {{this.inserted}}</p>
  {{/if}}

  {{#if this.error}}
    <p class="upload__error" aria-live="polite">✗ Грешка: {{this.error}}</p>
  {{/if}}
</form>