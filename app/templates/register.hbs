{{page-title "Регистрация"}}

<section class="auth">
  {{#if this.success}}
    <div class="auth__card">
      <h2>Готово</h2>
      <p class="auth__hint">
        Акаунтът е създаден успешно. Вече можете да влезете.
      </p>
      <LinkTo @route="login" class="auth__button auth__button--link">
        Към вход
      </LinkTo>
    </div>
  {{else}}
    <form class="auth__card" {{on "submit" this.submit}}>
      <h2>Регистрация</h2>
      <p class="auth__hint">Създайте акаунт, за да използвате функциите на
        сайта.</p>

      <label class="auth__field">
        <span>Потребител</span>
        <input
          type="text"
          name="user"
          autocomplete="username"
          value={{this.user}}
          {{on "input" (fn this.updateField "user")}}
        />
      </label>

      <label class="auth__field">
        <span>Парола</span>
        <input
          type="password"
          name="password"
          autocomplete="new-password"
          value={{this.password}}
          {{on "input" (fn this.updateField "password")}}
        />
      </label>

      <label class="auth__field">
        <span>Тип достъп</span>
        <select {{on "change" this.setMode}}>
          <option value="window" selected={{this.isWindow}}>
            Времеви прозорец (от–до, макс. 1 година)
          </option>
          <option value="count" selected={{this.isCount}}>
            Брой влизания
          </option>
        </select>
      </label>

      {{#if this.isWindow}}
        <div class="auth__row">
          <label class="auth__field">
            <span>Активен от</span>
            <input
              type="date"
              value={{this.from}}
              {{on "input" (fn this.updateField "from")}}
            />
          </label>
          <label class="auth__field">
            <span>Активен до</span>
            <input
              type="date"
              value={{this.to}}
              {{on "input" (fn this.updateField "to")}}
            />
          </label>
        </div>
      {{else}}
        <label class="auth__field">
          <span>Брой разрешени влизания</span>
          <input
            type="number"
            min="1"
            value={{this.nmax}}
            {{on "input" (fn this.updateField "nmax")}}
          />
        </label>
      {{/if}}

      <button type="submit" class="auth__button" disabled={{this.isDisabled}}>
        {{if this.isSubmitting "Създаване..." "Регистрация"}}
      </button>

      {{#if this.error}}
        <p class="auth__error" aria-live="polite">✗ {{this.error}}</p>
      {{/if}}

      <p class="auth__switch">
        Вече имате акаунт?
        <LinkTo @route="login">Вход</LinkTo>
      </p>
    </form>
  {{/if}}
</section>